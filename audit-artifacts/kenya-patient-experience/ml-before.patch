diff --git a/inference/backend_adapter.py b/inference/backend_adapter.py
index e2c3098..62ccdd7 100644
--- a/inference/backend_adapter.py
+++ b/inference/backend_adapter.py
@@ -7,6 +7,9 @@ Converts confirmed DDXPlus evidence codes into the saved
 Important:
 - Rejected NLP suggestions are NOT explicit symptom absences.
 - Unreported symptoms remain unknown.
+- The frozen prototype never learned a split on an absence column. Explicit
+  absences are preserved for state integrity but do not affect its raw scores.
+- Duration and severity are not supported model inputs.
 - The backend must perform red-flag checks before prediction.
 - Model outputs are not medical diagnoses.
 """
diff --git a/inference/prediction_confidence.py b/inference/prediction_confidence.py
index aacddcb..64d4e9b 100644
--- a/inference/prediction_confidence.py
+++ b/inference/prediction_confidence.py
@@ -24,6 +24,9 @@ def assess_prediction(
     if len(classes) < 2 or len(classes) != len(scores):
         raise ValueError("Classes and scores must have matching lengths >= 2.")
 
+    if len(classes) != len(set(classes)) or any(not label for label in classes):
+        raise ValueError("Classes must have unique non-empty labels.")
+
     if not 0 <= min_confidence <= 1:
         raise ValueError("min_confidence must be between 0 and 1.")
 
diff --git a/inference/v2_predictor.py b/inference/v2_predictor.py
index 9bc72c2..fa637d6 100644
--- a/inference/v2_predictor.py
+++ b/inference/v2_predictor.py
@@ -30,7 +30,9 @@ def load_v2_resources():
 
     feature_names = schema["feature_names"]
 
-    if len(feature_names) != 66:
+    if (len(feature_names) != 66
+            or not all(isinstance(name, str) and name for name in feature_names)
+            or len(set(feature_names)) != 66):
         raise ValueError("Expected exactly 66 V2 features.")
 
     if model.n_features_in_ != len(feature_names):
@@ -39,6 +41,12 @@ def load_v2_resources():
     if len(model.classes_) != 23:
         raise ValueError("Expected exactly 23 prediction classes.")
 
+    if len(set(str(label) for label in model.classes_)) != 23:
+        raise ValueError("Model classes must be unique.")
+
+    if not callable(getattr(model, "predict_proba", None)):
+        raise ValueError("Saved model must support predict_proba.")
+
     if hasattr(model, "feature_names_in_"):
         if list(model.feature_names_in_) != feature_names:
             raise ValueError("Model feature order does not match schema.")
@@ -89,6 +97,8 @@ def predict_v2(feature_values):
         if feature == "AGE":
             if value < 0:
                 raise ValueError("AGE must be non-negative.")
+            if value > 120:
+                raise ValueError("AGE must not exceed 120.")
         elif value not in (0.0, 1.0):
             raise ValueError(
                 f"{feature} must be encoded as 0 or 1."
@@ -122,4 +132,26 @@ def predict_v2(feature_values):
 
     result["model_version"] = "v2_23class_prototype"
 
+    # Score separation alone cannot establish clinical certainty. The frozen
+    # research artifact has no independent real-patient validation, including
+    # for its two synthetic extension classes. Keep its raw scores unchanged.
+    result["model_score_ambiguous"] = result["uncertain"]
+    result["uncertain"] = True
+    result["uncertainty_reasons"].append("not_clinically_validated")
+    result["model_status"] = "research_prototype"
+    result["clinical_validation"] = False
+    result["message"] = (
+        "This experimental model suggests a condition pattern, but cannot "
+        "establish a diagnosis or rule out serious illness."
+    )
+    used_features = {
+        feature_names[int(index)]
+        for estimator in getattr(model, "estimators_", [])
+        for index in estimator.tree_.feature if index >= 0
+    }
+    result["learned_absence_features"] = sorted(
+        feature for feature in used_features if feature.endswith("__absent")
+    )
+    result["duration_features_supported"] = False
+
     return result
